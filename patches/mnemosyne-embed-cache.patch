+def _cache_get(key: str):
+    global _EMBED_CACHE_BYTES, _EMBED_CACHE_HITS
+    if _embed_cache_max_entries() <= 0:
+        return None
+    with _EMBED_CACHE_LOCK:
+        vec = _EMBED_CACHE.get(key)
+        if vec is None:
+            return None
+        _EMBED_CACHE.move_to_end(key)
+        _EMBED_CACHE_HITS += 1
+        return vec
+
