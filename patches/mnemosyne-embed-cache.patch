+def _prefetch_put(key: str, vec: np.ndarray) -> None:
+    global _EMBED_PREFETCH_BYTES
+    arr = np.asarray(vec, dtype=np.float32)
+    with _EMBED_PREFETCH_LOCK:
+        old = _EMBED_PREFETCH.get(key)
