+def prefetch_embeddings(texts: List[str], kind: str = "doc"):
+    """Explicitly precompute vectors and retain them outside the normal LRU.
+
+    This is the P0.5 hook that lets Phase A own all embedding HTTP even when
+    MNEMOSYNE_EMBED_CACHE_SIZE=0.  Normal ``embed()``/``embed_query()`` calls
+    consult the prefetch buffer first, so the write phase is cache-only.
+    """
+    if not texts:
+        return None
+    raw_texts = list(texts)
+    if _is_disabled():
+        return None
+    prefix = _get_prefix(kind)
+    keys = [_embed_cache_key(t, kind, prefix) for t in raw_texts]
+    missing = []
+    for text, key in zip(raw_texts, keys):
+        if _prefetch_get(key) is not None:
+            continue
+        if _embed_cache_max_entries() > 0:
+            cached = _cache_get(key)
+            if cached is not None:
+                _prefetch_put(key, cached)
+                continue
+        missing.append(text)
+    if missing:
+        # This call performs the actual HTTP/local embedding.  Its normal
+        # destination may be disabled, so we cache the result explicitly.
+        raw = _embed_cached_batch(missing, kind)
+        if raw is None:
+            return None
+        raw_arr = np.asarray(raw, dtype=np.float32)
+        if raw_arr.ndim == 1:
+            raw_arr = raw_arr.reshape(1, -1)
+        if len(raw_arr) != len(missing):
+            return None
+        for text, vec in zip(missing, raw_arr):
+            _prefetch_put(_embed_cache_key(text, kind, prefix), vec)
+    out = []
+    for text, key in zip(raw_texts, keys):
+        vec = _prefetch_get(key)
+        if vec is None and _embed_cache_max_entries() > 0:
+            vec = _cache_get(key)
+        if vec is None:
+            return None
+        out.append(np.asarray(vec, dtype=np.float32))
+    try:
+        return np.stack(out)
+    except Exception:
+        return None
+
