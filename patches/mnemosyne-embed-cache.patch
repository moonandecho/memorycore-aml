+def prime_embeddings(texts: List[str], vectors, kind: str = "doc") -> Optional[np.ndarray]:
+    """Retain already-computed vectors in the explicit Phase-A buffer.
+
+    Adapters with their own embedding transport (or tests that monkeypatch
+    embed_queries/embed) can precompute vectors without going through
+    _embed_cached_batch, then prime the same buffer so the write phase stays
+    cache-only even when MNEMOSYNE_EMBED_CACHE_SIZE=0.
+    """
+    if not texts:
+        return None
+    try:
+        arr = np.asarray(vectors, dtype=np.float32)
+    except Exception:
+        return None
+    if arr.ndim == 1:
+        arr = arr.reshape(1, -1)
+    if len(arr) != len(texts):
+        return None
+    prefix = _get_prefix(kind)
+    for text, vec in zip(texts, arr):
+        key = _embed_cache_key(text, kind, prefix)
+        _prefetch_put(key, vec)
+        if _embed_cache_max_entries() > 0:
+            _cache_put(key, vec)
+    return arr
+
