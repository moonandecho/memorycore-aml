+def _ollama_meta_from_env() -> dict:
+    return {
+        "digest": os.environ.get("MNEMOSYNE_EMBED_MODEL_DIGEST", ""),
+        "num_ctx": os.environ.get("MNEMOSYNE_EMBED_NUM_CTX", ""),
+        "num_gpu": os.environ.get("MNEMOSYNE_EMBED_NUM_GPU", ""),
+        "ollama_version": os.environ.get("MNEMOSYNE_OLLAMA_VERSION", ""),
+    }
+
+
+def _fetch_ollama_meta(model: str, base_url: str) -> dict:
+    """Best-effort /api/show + /api/ps probe; disabled unless explicitly enabled.
+
+    The production launcher sets the env values directly; this hook is for
+    operators and tests that want the patch to discover the real tag/digest/
+    num_ctx/num_gpu instead of trusting hand-written values.
+    """
+    if os.environ.get("MNEMOSYNE_EMBED_FINGERPRINT_FETCH", "").strip().lower() not in ("1", "true", "yes", "on"):
+        return {}
+    origin = (base_url or "").rstrip("/")
+    if origin.endswith("/v1"):
+        origin = origin[:-3]
+    if not origin:
+        return {}
+    out = {}
+    try:
+        req = urllib.request.Request(
+            origin + "/api/show",
+            data=json.dumps({"name": model}).encode(),
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urllib.request.urlopen(req, timeout=1.0) as resp:
+            data = json.loads(resp.read())
+        details = data.get("details") or {}
+        model_info = data.get("model_info") or {}
+        out["digest"] = str(data.get("digest") or "")
+        out["num_ctx"] = str(details.get("context_length") or model_info.get("general.context_length") or "")
+        # num_gpu is a Modelfile parameter, not exposed by /api/show in all
+        # versions; keep env override authoritative when present.
+        out["num_gpu"] = os.environ.get("MNEMOSYNE_EMBED_NUM_GPU", "")
+        out["ollama_version"] = str(data.get("version") or os.environ.get("MNEMOSYNE_OLLAMA_VERSION", ""))
+    except Exception:
+        pass
+    try:
+        with urllib.request.urlopen(origin + "/api/ps", timeout=1.0) as resp:
+            data = json.loads(resp.read())
+        for item in data.get("models", []):
+            if item.get("name") == model or item.get("model") == model:
+                out["num_gpu"] = str(item.get("num_gpu", out.get("num_gpu", "")))
+                out["gpu_percent"] = str(item.get("processor", ""))
+                break
+    except Exception:
+        pass
+    return out
+
+
+def _model_fingerprint() -> dict:
+    """Return a stable dict that changes whenever vector semantics change."""
+    global _MODEL_FINGERPRINT_CACHE, _MODEL_FINGERPRINT_KEY
+    base_url = os.environ.get("MNEMOSYNE_EMBEDDING_API_URL", "")
+    key = (str(_DEFAULT_MODEL), str(base_url), str(EMBEDDING_DIM))
+    if _MODEL_FINGERPRINT_CACHE is not None and _MODEL_FINGERPRINT_KEY == key:
+        return dict(_MODEL_FINGERPRINT_CACHE)
+    meta = _ollama_meta_from_env()
+    fetched = _fetch_ollama_meta(str(_DEFAULT_MODEL), str(base_url))
+    for k, v in fetched.items():
+        if v and not meta.get(k):
+            meta[k] = v
+    fp = {
+        "model": str(_DEFAULT_MODEL),
+        "url": str(base_url),
+        "dim": int(EMBEDDING_DIM),
+        "digest": str(meta.get("digest") or ""),
+        "num_ctx": str(meta.get("num_ctx") or ""),
+        "num_gpu": str(meta.get("num_gpu") or ""),
+        "ollama_version": str(meta.get("ollama_version") or ""),
+    }
+    _MODEL_FINGERPRINT_CACHE = dict(fp)
+    _MODEL_FINGERPRINT_KEY = key
+    return dict(fp)
+
+
+def _embed_cache_key(text: str, kind: str, prefix: str) -> str:
+    fp = _model_fingerprint()
+    payload = json.dumps({
+        "fingerprint": fp,
+        "prefix_kind": kind,
+        "prefix": prefix,
+        "text": text,
+    }, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _cache_get(key: str):
+    global _EMBED_CACHE_BYTES, _EMBED_CACHE_HITS
+    if _embed_cache_max_entries() <= 0:
+        return None
+    with _EMBED_CACHE_LOCK:
+        vec = _EMBED_CACHE.get(key)
+        if vec is None:
+            return None
+        _EMBED_CACHE.move_to_end(key)
+        _EMBED_CACHE_HITS += 1
+        return vec
+
+
+def _cache_put(key: str, vec: np.ndarray) -> None:
+    global _EMBED_CACHE_BYTES, _EMBED_CACHE_MISSES
+    if _embed_cache_max_entries() <= 0:
+        return
+    arr = np.asarray(vec, dtype=np.float32)
+    with _EMBED_CACHE_LOCK:
+        _EMBED_CACHE_MISSES += 1
+        old = _EMBED_CACHE.get(key)
+        if old is not None:
+            _EMBED_CACHE_BYTES = max(0, _EMBED_CACHE_BYTES - int(old.nbytes))
+            _EMBED_CACHE.move_to_end(key)
+        _EMBED_CACHE[key] = arr
+        _EMBED_CACHE_BYTES += int(arr.nbytes) + len(key) + 64
+        max_entries = _embed_cache_max_entries()
+        max_bytes = _embed_cache_max_bytes()
+        while _EMBED_CACHE and (len(_EMBED_CACHE) > max_entries or _EMBED_CACHE_BYTES > max_bytes):
+            _old_key, old_vec = _EMBED_CACHE.popitem(last=False)
+            _EMBED_CACHE_BYTES = max(0, _EMBED_CACHE_BYTES - int(old_vec.nbytes) - len(_old_key) - 64)
+
