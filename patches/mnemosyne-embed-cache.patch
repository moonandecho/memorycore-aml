+            "entries": len(_EMBED_CACHE),
+            "bytes": int(_EMBED_CACHE_BYTES),
+            "max_entries": _embed_cache_max_entries(),
+            "max_bytes": _embed_cache_max_bytes(),
+            "hits": int(_EMBED_CACHE_HITS),
+            "misses": int(_EMBED_CACHE_MISSES),
+            "model_fingerprint": _model_fingerprint(),
+        }
+
+
+def cache_clear() -> None:
+    global _EMBED_CACHE_BYTES, _EMBED_CACHE_HITS, _EMBED_CACHE_MISSES
+    with _EMBED_CACHE_LOCK:
+        _EMBED_CACHE.clear()
+        _EMBED_CACHE_BYTES = 0
+        _EMBED_CACHE_HITS = 0
+        _EMBED_CACHE_MISSES = 0
