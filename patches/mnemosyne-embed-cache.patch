+def _embed_cached_batch(texts: List[str], kind: str) -> Optional[np.ndarray]:
+    """Embed raw texts with prefix kind, reusing/updating the process cache."""
+    global _API_CALL_COUNT
+    if not texts:
+        return None
+    raw_texts = list(texts)
+    if _is_disabled():
+        return None
+    prefix = _get_prefix(kind)
+    use_cache = _embed_cache_max_entries() > 0
+    keys = [_embed_cache_key(t, kind, prefix) for t in raw_texts]
+    found = {}
+    misses = []
+    for i, key in enumerate(keys):
+        # Explicit Phase-A prefetch is always checked first, even when the
+        # normal LRU is disabled (MNEMOSYNE_EMBED_CACHE_SIZE=0).
+        v = _prefetch_get(key)
+        if v is None and use_cache:
+            v = _cache_get(key)
+        if v is not None:
+            found[i] = v
+        else:
+            misses.append((i, raw_texts[i]))
+    if not misses:
+        try:
+            return np.stack([np.asarray(found[i], dtype=np.float32) for i in range(len(raw_texts))])
+        except Exception:
+            return None
+    miss_texts = [t for _i, t in misses]
+    prefixed = [prefix + t for t in miss_texts]
+    if _is_api_model(_DEFAULT_MODEL):
+        raw = _embed_api(prefixed)
+    else:
+        model = _get_model()
+        if model is None or model == "api":
+            return None
+        try:
+            raw = np.stack(list(model.embed(prefixed))).astype(np.float32)
+        except Exception:
+            return None
+    if raw is None:
+        return None
+    try:
+        raw_arr = np.asarray(raw, dtype=np.float32)
+    except Exception:
+        return None
+    if raw_arr.ndim == 1:
+        raw_arr = raw_arr.reshape(1, -1)
+    if len(raw_arr) != len(miss_texts):
+        return None
+    for j, (i, _text) in enumerate(misses):
+        found[i] = raw_arr[j]
+        if use_cache:
+            _cache_put(keys[i], raw_arr[j])
+    try:
+        return np.stack([np.asarray(found[i], dtype=np.float32) for i in range(len(raw_texts))])
+    except Exception:
+        return None
+
