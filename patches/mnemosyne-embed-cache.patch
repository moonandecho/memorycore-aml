+def _env_int(name: str, default: int) -> int:
+    raw = os.environ.get(name)
+    if raw is None or str(raw).strip() == "":
+        return default
+    try:
+        return int(str(raw).strip())
+    except (TypeError, ValueError):
+        return default
+
+
+def _embed_cache_max_entries() -> int:
+    return max(0, _env_int("MNEMOSYNE_EMBED_CACHE_SIZE", 8192))
+
+
+def _embed_cache_max_bytes() -> int:
+    return max(0, _env_int("MNEMOSYNE_EMBED_CACHE_BYTES", 64 * 1024 * 1024))
+
