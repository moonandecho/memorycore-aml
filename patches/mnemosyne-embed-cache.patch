+    if _is_disabled():
+        return False
+    prefix = _get_prefix(kind)
+    for text in texts:
+        key = _embed_cache_key(text, kind, prefix)
+        if _prefetch_get(key) is not None:
+            continue
+        if _embed_cache_max_entries() > 0 and _cache_get(key) is not None:
+            continue
+        return False
+    return True
